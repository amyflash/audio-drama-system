# ========================
# 🌍 运行环境选择
# ========================
# 值: development / testing / production
ENV=development
PORT=8001

# ========================
# 📦 数据库配置
# ========================
DATABASE_URL=sqlite:///./data/audio_drama.db
MEDIA_DIR=media1/albums

# ========================
# 🔐 认证与密钥配置
# ========================
SECRET_KEY=your-secret-key-change-in-production
JWT_SECRET_KEY=your-jwt-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_SECONDS=1800

# ========================
# 🔗 SSO 单点登录
# ========================
SSO_ENABLED=true
SSO_JWT_AUTH_URL=http://localhost:8000
SSO_SECRET_KEY=your-jwt-auth-secret-key
SSO_ALGORITHM=HS256

# ========================
# 🌐 CORS 跨域配置 (关键!)
# ========================
# 说明: 
#   - 留空: 自动选择 (开发时http://localhost:5173, 生产时禁用)
#   - 指定值: 逗号分隔的域名列表
#
# 开发环境推荐: ALLOW_ORIGINS= (留空，自动配置)
# 生产环境推荐: ALLOW_ORIGINS= (留空，同域部署无需CORS)
# 多前端应用: ALLOW_ORIGINS=https://app.com,https://api.com
#
ALLOW_ORIGINS=

# ========================
# 📤 文件上传配置
# ========================
UPLOAD_MAX_FILE_SIZE=104857600
STREAM_TOKEN_EXPIRE_SECONDS=600

# ========================
# ⚙️ 并发控制
# ========================
MAX_CONCURRENT_USERS=10
SESSION_EXPIRE_SECONDS=1800

# ========================
# 👤 默认账号
# ========================
DEFAULT_ADMIN_PASSWORD=123456

